<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">

        <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="44sp" android:textStyle="bold"
            android:gravity="center" android:textColor="@color/green"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/tagline" android:gravity="center" android:textSize="15sp"
            android:layout_marginBottom="20dp"/>

        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="20sp" android:textStyle="bold" android:gravity="center"/>
        <TextView android:id="@+id/tvBlocked" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/tvStreak" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:layout_marginBottom="12dp"/>

        <Button android:id="@+id/btnToggle" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <LinearLayout android:id="@+id/cardPause" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp" android:layout_marginTop="24dp"
            android:background="#1A1B5E4B">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/pause_title" android:textStyle="bold" android:textSize="18sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/pause_quote" android:layout_marginTop="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/pause_question" android:textStyle="bold" android:layout_marginTop="12dp"/>
            <Button android:id="@+id/btnYes" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/yes_lock"/>
            <Button android:id="@+id/btnNo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/not_yet"/>
            <TextView android:id="@+id/tvYesNote" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/yes_note" android:visibility="gone" android:layout_marginTop="8dp"/>
        </LinearLayout>

        <TextView android:id="@+id/tvLock" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/lock_on" android:gravity="center" android:layout_marginTop="16dp" android:visibility="gone"/>
        <Button android:id="@+id/btnReqDisable" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/req_disable" android:visibility="gone"/>
        <Button android:id="@+id/btnRemoveAdmin" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/remove_admin" android:visibility="gone"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/language" android:layout_marginTop="24dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnAr" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="العربية"/>
            <Button android:id="@+id/btnEn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="English"/>
            <Button android:id="@+id/btnFr" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Français"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
